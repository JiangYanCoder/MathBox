# 依赖目录
node_modules/

# 构建产物（核心：GitHub Actions 会自动构建并发布它们，源码无需提交）
# 注意：styles.css 必须入库 —— 它是手写源文件，CI 只构建 main.js
main.js
*.js.map
*.css.map

# 本地打包输出（scripts/package.mjs 生成，含 main.js 等构建产物）
release/

# 本地发布与测试目录
发布流程说明.md

# 本地插件数据（用户设置不应提交）
data.json

# 脚本/工具临时文件（按需）
scripts/*.log
scripts/temp/

# 自检脚本的打包产物（npm run selftest 生成，源码是 scripts/selftest.ts）
scripts/selftest.mjs

# 编辑器与系统垃圾
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Claude Code 个人权限配置（含本机放行的命令，不应入库）
# 注意：只忽略 settings.local.json；.claude/ 下的项目级配置（skills、commands 等）仍可入库
.claude/settings.local.json
